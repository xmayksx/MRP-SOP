def get_base_unit(sku):
  s = str(sku).strip()
  if s.startswith("05"):
    return "KG"
  if s.startswith("06"):
    return "BOLSAS"
  if s.startswith("18"):
    return "UNIDADES"
  return "BOLSAS"


def obtener_factor_kg(sku, desc):
  sku_str = str(sku).strip().upper()
  desc_str = str(desc).strip().upper()
  if sku_str.startswith("18") or sku_str.endswith("18"):
    return 0.0

  mapa_premezclas = {
      "05-0400141": 35.0,
      "05-0400140": 35.0,
      "05-0400154": 40.0,
      "05-0400129": 40.0,
      "05-0400058": 40.0,
      "05-0400059": 40.0,
      "05-0400060": 40.0,
      "05-0400061": 40.0,
      "05-0400063": 40.0,
      "05-0400064": 40.0,
      "05-0400130": 30.0,
      "05-0500010": 30.0,
      "05-0500006": 40.0,
      "05-0500007": 40.0,
      "05-0500008": 40.0,
      "05-0500009": 40.0,
      "05-0500011": 40.0,
      "05-0500012": 40.0,
      "05-0400157": 25.0,
      "05-0400158": 20.0,
  }
  if sku_str in mapa_premezclas:
    return mapa_premezclas[sku_str]

  if sku_str.startswith("06") or sku_str.endswith("06") or "KG" in desc_str:
    match = re.search(r"(\d+(?:\.\d+)?)\s*KG", desc_str)
    if match:
      return float(match.group(1))
  return 1.0


def convert_to_display(valor_base, sku, factor_kg, unidad_destino):
  base = get_base_unit(sku)
  if base == "UNIDADES":
    return (
        valor_base
        if unidad_destino == "Unidades Físicas (Bolsas/Pzs)"
        else 0.0
    )

  if base == "KG":
    kg_val = valor_base
  elif base == "BOLSAS":
    kg_val = valor_base * factor_kg if factor_kg > 0 else valor_base
  else:
    kg_val = valor_base

  if unidad_destino == "Kilogramos (KG)":
    return kg_val
  if unidad_destino == "Quintales (QQ)":
    return kg_val / 45.3592
  if unidad_destino == "Unidades Físicas (Bolsas/Pzs)":
    if base == "BOLSAS":
      return valor_base
    if base == "KG":
      return valor_base / factor_kg if factor_kg > 0 else valor_base
  return valor_base


def convert_from_display(valor_disp, sku, factor_kg, unidad_origen):
  base = get_base_unit(sku)
  if base == "UNIDADES":
    return (
        valor_disp if unidad_origen == "Unidades Físicas (Bolsas/Pzs)" else 0.0
    )

  if unidad_origen == "Kilogramos (KG)":
    kg_val = valor_disp
  elif unidad_origen == "Quintales (QQ)":
    kg_val = valor_disp * 45.3592
  elif unidad_origen == "Unidades Físicas (Bolsas/Pzs)":
    if base == "BOLSAS" or base == "KG":
      kg_val = valor_disp * factor_kg if factor_kg > 0 else valor_disp
    else:
      kg_val = valor_disp
  else:
    kg_val = valor_disp

  if base == "KG":
    return kg_val
  elif base == "BOLSAS":
    return kg_val / factor_kg if factor_kg > 0 else kg_val
  return valor_disp


def to_kg_from_display(valor_disp, sku, factor_kg, unidad_origen):
  val_base = convert_from_display(valor_disp, sku, factor_kg, unidad_origen)
  return convert_to_display(val_base, sku, factor_kg, "Kilogramos (KG)")


def calcular_metricas_demanda(serie_demanda, fecha_corte=None):
  if serie_demanda.empty:
    return {1: {"mean": 0.0, "std": 0.0}}
  media = serie_demanda.mean()
  desviacion = serie_demanda.std()
  return {
      1: {
          "mean": media if not pd.isna(media) else 0.0,
          "std": desviacion if not pd.isna(desviacion) else 0.0,
      }
  }


