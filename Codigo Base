      [
          os.path.join(RUTAS["VENTAS"], f)
          for f in os.listdir(RUTAS["VENTAS"])
          if f.endswith((".xlsx", ".xls")) and not f.startswith("~")
      ]
      if os.path.exists(RUTAS["VENTAS"])
      else []
  )
  dfs_v = []
  for p in excels_v:
    try:
      dfs_v.append(pd.read_excel(p, sheet_name="BD"))
    except Exception as e:
      st.warning(f"Error cargando archivo de ventas {os.path.basename(p)}: {e}")

  if not dfs_v:
    return pd.DataFrame()

  df = pd.concat(dfs_v, ignore_index=True)
  df.columns = df.columns.astype(str).str.strip()
  df = df.drop_duplicates()

  df["Item"] = (
      df["Item"].astype(str).str.replace(r"\.0$", "", regex=True).str.strip()
  )
  df["Fecha"] = pd.to_datetime(df["Fecha"], dayfirst=True, errors="coerce")
  df["Valor"] = (
      pd.to_numeric(df["Valor"], errors="coerce").fillna(0).clip(lower=0)
  )

  df = df[df["Fecha"] >= "2022-01-01"]

  if "Categoria" in df.columns:
    df["Categoria"] = df["Categoria"].astype(str).str.strip().str.upper()
  return df


