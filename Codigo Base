                    "Fecha Recepción Real",
                ]],
                on=["Codigo_T", "Fecha_T", "Cantidad_Raw"],
                how="left",
                suffixes=("", "_manual"),
            )

            mask_man = df_otif["Estatus_Manual"].notna()
            df_otif.loc[mask_man, "Estatus_T"] = df_otif.loc[
                mask_man, "Estatus_Manual"
            ]
            df_otif.loc[mask_man, "Fecha Recepción Real"] = df_otif.loc[
                mask_man, "Fecha Recepción Real_manual"
            ]
            df_otif.drop(
                columns=["Estatus_Manual", "Fecha Recepción Real_manual"],
                inplace=True,
            )
          except Exception as e:
            st.warning(f"Error procesando auditoría manual OTIF: {e}")

        def calc_otif_status(row):
          if "RECIBIDO" in str(row["Estatus_T"]).upper():
            f_real = row["Fecha Recepción Real"]
            f_eta = row["Fecha_T"]
            if pd.isna(f_real):
              return "Recibido a Tiempo"
            if (f_real - f_eta).days > 0:
              return "Recibido con Retraso"
            return "Recibido a Tiempo"
          else:
            if row["Dias_Desde_ETA"] > 0:
              return "Retrasado (Pendiente)"
            return "A Tiempo (Pendiente)"

        df_otif["Estatus_OTIF"] = df_otif.apply(calc_otif_status, axis=1)
        st.session_state.df_otif_raw = df_otif.copy()

        t_mrp = df_otif[
            ~df_otif["Estatus_T"].str.upper().str.contains("RECIBIDO", na=False)
        ].copy()
        t_mrp.loc[t_mrp["Fecha_T"] < inicio_semana_actual, "Fecha_T"] = (
            inicio_semana_actual
        )
        if not t_mrp.empty:
          df_transito = (
              t_mrp.groupby(
                  ["Codigo_T", pd.Grouper(key="Fecha_T", freq="W-SAT")]
              )["Cantidad_T"]
              .sum()
              .reset_index()
          )

      df_comercial = pd.DataFrame()
      if os.path.exists(RUTAS["COMERCIAL"]):
        try:
          excels_c = [
              os.path.join(RUTAS["COMERCIAL"], f)
              for f in os.listdir(RUTAS["COMERCIAL"])
              if f.endswith((".xlsx", ".xls")) and not f.startswith("~")
          ]
          dfs_c = [pd.read_excel(p, sheet_name="BD") for p in excels_c]
          if dfs_c:
            df_com = pd.concat(dfs_c, ignore_index=True)
            df_com.columns = df_com.columns.astype(str).str.strip()
            df_com = df_com.drop_duplicates()
            df_com["Item"] = (
                df_com["Item"]
                .astype(str)
                .str.replace(r"\.0$", "", regex=True)
                .str.strip()
            )
            df_com["Fecha"] = pd.to_datetime(
                df_com["Fecha"], dayfirst=True, errors="coerce"
            )
            if "Valor" in df_com.columns:
              df_com["Valor"] = (
                  pd.to_numeric(df_com["Valor"], errors="coerce")
                  .fillna(0)
                  .clip(lower=0)
              )
              df_com.rename(columns={"Valor": "FCST_Comercial"}, inplace=True)
            df_comercial = (
                df_com.groupby(["Item", pd.Grouper(key="Fecha", freq="W-SAT")])[
                    "FCST_Comercial"
                ]
                .sum()
                .reset_index()
            )
        except Exception as e:
          st.warning(f"Error procesando pronóstico comercial: {e}")

      df_hist_weekly = (
          df_base_raw.groupby([
              "Item",
              "Descripción",
              "Categoria",
              pd.Grouper(key="Fecha", freq="W-SAT"),
          ])["Valor"]
          .sum()
          .reset_index()
      )
      max_date_global = df_hist_weekly["Fecha"].max()

      global_metrics = []
      for (sku, desc, cat), group in df_hist_weekly.groupby(
          ["Item", "Descripción", "Categoria"]
      ):
        avg_2w = (
            group[group["Fecha"] > max_date_global - pd.Timedelta(weeks=2)][
                "Valor"
            ].mean()
            if not group[
                group["Fecha"] > max_date_global - pd.Timedelta(weeks=2)
            ].empty
            else 0
        )
        avg_4w = (
            group[group["Fecha"] > max_date_global - pd.Timedelta(weeks=4)][
                "Valor"
            ].mean()
            if not group[
                group["Fecha"] > max_date_global - pd.Timedelta(weeks=4)
            ].empty
            else 0
        )
        avg_6w = (
            group[group["Fecha"] > max_date_global - pd.Timedelta(weeks=6)][
                "Valor"
            ].mean()
            if not group[
                group["Fecha"] > max_date_global - pd.Timedelta(weeks=6)
            ].empty
            else 0
        )
        avg_8w = (
            group[group["Fecha"] > max_date_global - pd.Timedelta(weeks=8)][
                "Valor"
            ].mean()
            if not group[
                group["Fecha"] > max_date_global - pd.Timedelta(weeks=8)
            ].empty
            else 0
        )

        valores_6w_g = group[
            group["Fecha"] > max_date_global - pd.Timedelta(weeks=6)
        ]["Valor"].sort_values(ascending=False)
        m1 = valores_6w_g.iloc[0] if len(valores_6w_g) > 0 else 0
        m2 = valores_6w_g.iloc[1] if len(valores_6w_g) > 1 else m1
        consumo_simulado_global = (
            (m1 + m2 + avg_4w) / 3 if not group.empty else 0
        )
        max_6w = m1

        suma_2w = group[
            group["Fecha"] > max_date_global - pd.Timedelta(weeks=2)
        ]["Valor"].sum()
        suma_4w_prev = group[
            (group["Fecha"] <= max_date_global - pd.Timedelta(weeks=2))
            & (group["Fecha"] > max_date_global - pd.Timedelta(weeks=6))
        ]["Valor"].sum()

        promedio_2w_var = suma_2w / 2
        promedio_4w_prev_var = suma_4w_prev / 4

        variacion_consumo = 0.0
        if promedio_4w_prev_var > 0:
          variacion_consumo = (
              promedio_2w_var - promedio_4w_prev_var
          ) / promedio_4w_prev_var
        elif promedio_2w_var > 0:
          variacion_consumo = 1.0

        global_metrics.append({
            "SKU": sku,
            "Descripción": desc,
            "Categoria": cat,
            "Demanda Semanal 2W": avg_2w,
            "Demanda Semanal 4W": avg_4w,
            "Demanda Semanal 6W": avg_6w,
            "Demanda Semanal 8W": avg_8w,
            "Consumo Simulado (Fórmula)": consumo_simulado_global,
            "Max Consumo Semanal 6W": max_6w,
            "Variación Consumo": variacion_consumo,
        })

      df_global = pd.DataFrame(global_metrics)
      if not df_global.empty:
        df_global["Demanda Semanal"] = df_global["Consumo Simulado (Fórmula)"]
        df_global["Demanda Diaria"] = df_global["Demanda Semanal"] / 7
        df_global["Demanda Mensual"] = df_global["Demanda Diaria"] * 30

        if not df_inv.empty:
          df_inv_g = (
              df_inv.groupby("CODIGO")[["CANTIDAD", "MONTO"]]
              .sum()
              .reset_index()
              .rename(
                  columns={
                      "CODIGO": "SKU",
                      "CANTIDAD": "Inventario Actual",
                      "MONTO": "Valor",
                  }
              )
          )
          df_global = pd.merge(df_global, df_inv_g, on="SKU", how="left").fillna(
              {"Inventario Actual": 0, "Valor": 0}
          )
        else:
          df_global["Inventario Actual"], df_global["Valor"] = 0.0, 0.0

        if not df_transito.empty:
          df_t_g = (
              df_transito.groupby("Codigo_T")["Cantidad_T"]
              .sum()
              .reset_index()
              .rename(columns={"Codigo_T": "SKU", "Cantidad_T": "Tránsito"})
          )
          df_global = pd.merge(df_global, df_t_g, on="SKU", how="left").fillna(
              {"Tránsito": 0}
          )
          st.session_state.prox_ingreso_global = df_transito[
              "Fecha_T"
          ].min().strftime("%Y-%m-%d")
        else:
          df_global["Tránsito"] = 0.0
          st.session_state.prox_ingreso_global = "N/A"

        df_global["Inventario + Tránsito"] = (
            df_global["Inventario Actual"] + df_global["Tránsito"]
        )
        st.session_state.df_global_dash = df_global
      else:
        st.session_state.df_global_dash = pd.DataFrame()
        st.session_state.prox_ingreso_global = "N/A"

      ui_fecha_max = df_filtrado_final["Fecha"].max()
      año_actual = ui_fecha_max.year
      df_procesar = df_filtrado_final.copy()
      fin_de_año = (
          pd.to_datetime(f"{año_actual}-12-31")
          if (pd.to_datetime(f"{año_actual}-12-31") - ui_fecha_max).days >= 30
          else pd.to_datetime(f"{año_actual+1}-12-31")
      )
      fechas_futuras = pd.date_range(
          start=ui_fecha_max + pd.Timedelta(days=1),
          end=fin_de_año,
          freq="W-SAT",
      )
      filas_futuras = [
          {
              "Item": r["Item"],
              "Descripción": r["Descripción"],
              "Categoria": r["Categoria"],
              "Fecha": f,
              "Valor": np.nan,
          }
          for _, r in df_procesar[
              ["Item", "Descripción", "Categoria"]
          ].drop_duplicates().iterrows()
          for f in fechas_futuras
      ]

      df_semanal = (
          pd.concat([df_procesar, pd.DataFrame(filas_futuras)], ignore_index=True)
          .sort_values(by=["Item", "Fecha"])
          .reset_index(drop=True)
      )
      df_semanal["Valor_Limpio"] = df_semanal["Valor"].copy()

      for item, grupo in df_semanal.groupby("Item"):
        idx = grupo.index
        s = grupo["Valor"].copy()
        s_limpio = s.copy()
        valid_data = s[s > 0]

        if len(valid_data) > 3:
          rolling_q1 = s.rolling(
              window=12, min_periods=1, center=True
          ).quantile(0.25)
          rolling_q3 = s.rolling(
              window=12, min_periods=1, center=True
          ).quantile(0.75)
          rolling_iqr = rolling_q3 - rolling_q1

          ls_dinamico = rolling_q3 + (1.5 * rolling_iqr)
          li_dinamico = np.maximum(0, rolling_q1 - (1.5 * rolling_iqr))

          for i in range(len(s)):
            val = s.iloc[i]
            lim_sup = ls_dinamico.iloc[i]
            lim_inf = li_dinamico.iloc[i]

            if pd.notna(lim_sup) and (
                val > lim_sup or val < lim_inf or val < 0
            ):
              prev_valid = s_limpio.iloc[max(0, i - 6) : i]
              if len(prev_valid) > 0:
                s_limpio.iloc[i] = prev_valid.mean()
              else:
                s_limpio.iloc[i] = valid_data.median()

        df_semanal.loc[idx, "Valor_Limpio"] = s_limpio

      cols_modelos = [
          "FCST_Promedio_Movil_4S_Opt",
          "FCST_SES",
          "FCST_HoltWinters",
          "FCST_RandomForest",
          "FCST_XGBoost",
      ]
      for col in cols_modelos:
        df_semanal[col] = np.nan
      features_ml = [
          "Lag_1",
          "Lag_2",
          "Lag_3",
          "Lag_4",
          "Lag_5",
          "Lag_6",
          "Lag_52",
          "Mes",
          "Semestre",
          "Semana_Año",
          "Tendencia",
          "PM_Feature",
      ]

      total_skus = len(df_semanal["Item"].unique())
      bar_progreso = st.progress(0)

      for idx_loop, (item, grupo) in enumerate(df_semanal.groupby("Item")):
        idx, df_item = grupo.index, grupo.copy()
        df_train = df_item[df_item["Fecha"] <= fecha_corte_entrenamiento]
        df_test = df_item[df_item["Fecha"] > fecha_corte_entrenamiento]
        valores_train = (
            df_train["Valor_Limpio"].dropna().astype(float).values
        )
        n_train, pasos_futuros = len(valores_train), len(df_test)
        if n_train == 0 or pasos_futuros == 0:
          continue

        pesos_item = np.array([0.10, 0.20, 0.30, 0.40])
        if n_train > 5:

          def f_err(w, v):
            return np.mean(
                [abs(v[i] - np.dot(v[i - 4 : i], w)) for i in range(4, len(v))]
            )

          res = minimize(
              f_err,
              pesos_item,
              args=(valores_train,),
              method="SLSQP",
              bounds=[(0, 1)] * 4,
              constraints=({"type": "eq", "fun": lambda w: 1 - sum(w)}),
          )
          if res.success:
            pesos_item = res.x

        try:
          m_ses = SimpleExpSmoothing(
              valores_train, initialization_method="heuristic"
          ).fit(optimized=True)
          df_semanal.loc[df_train.index, "FCST_SES"] = m_ses.fittedvalues
          df_semanal.loc[df_test.index, "FCST_SES"] = m_ses.forecast(
              len(df_test)
          )
        except Exception:
          pass

        try:
          p_hw = 52 if n_train >= 104 else (13 if n_train >= 26 else 4)
          m_hw = ExponentialSmoothing(
              valores_train,
              trend="add",
              seasonal="add",
              seasonal_periods=p_hw,
              initialization_method="estimated",
          ).fit(optimized=True)
          (
              df_semanal.loc[df_train.index, "FCST_HoltWinters"],
              df_semanal.loc[df_test.index, "FCST_HoltWinters"],
          ) = (m_hw.fittedvalues, m_hw.forecast(len(df_test)))
        except Exception:
          pass

        df_ml = df_item[["Fecha", "Valor_Limpio"]].copy()
        df_ml.loc[df_ml["Fecha"] > fecha_corte_entrenamiento, "Valor_Limpio"] = (
            np.nan
        )
        for c in ["Valor_PM", "Valor_RF", "Valor_XGB"]:
          df_ml[c] = df_ml["Valor_Limpio"].copy()
        df_ml["Mes"], df_ml["Semestre"] = df_ml["Fecha"].dt.month, np.where(
            df_ml["Fecha"].dt.month <= 6, 1, 2
        )
        df_ml["Semana_Año"], df_ml["Tendencia"] = df_ml[
            "Fecha"
        ].dt.strftime("%U").astype(int), np.arange(len(df_ml))
        df_ml["PM_Feature"] = (
            df_ml["Valor_Limpio"]
            .rolling(4, min_periods=1)
            .apply(
                lambda x: np.dot(x, pesos_item)
                if len(x) == 4
                else np.mean(x),
                raw=True,
            )
            .shift(1)
            .fillna(0)
        )
        for i in range(1, 7):
          df_ml[f"Lag_{i}"] = df_ml["Valor_Limpio"].shift(i)
        df_ml["Lag_52"] = df_ml["Valor_Limpio"].shift(52).fillna(0)

        train_ml = df_ml[
            df_ml["Fecha"] <= fecha_corte_entrenamiento
        ].dropna(subset=["Lag_1", "Lag_2", "Lag_3", "Lag_4", "Lag_5", "Lag_6"])

        if len(train_ml) > 5:
          try:
            rf_model = RandomForestRegressor(
                n_estimators=50, max_depth=5, random_state=42
            )
            xgb_model = xgb.XGBRegressor(
                n_estimators=50, max_depth=4, learning_rate=0.05, random_state=42
            )

            rf_model.fit(train_ml[features_ml], train_ml["Valor_Limpio"])
            xgb_model.fit(train_ml[features_ml], train_ml["Valor_Limpio"])

            X_hist = df_ml.loc[df_train.index, features_ml].fillna(0)
            df_semanal.loc[df_train.index, "FCST_RandomForest"] = (
                rf_model.predict(X_hist)
            )
            df_semanal.loc[df_train.index, "FCST_XGBoost"] = xgb_model.predict(
                X_hist
            )

            for i in df_test.index:
              npm = (
                  np.dot(
                      df_ml.loc[
                          max(idx[0], i - 4) : i - 1, "Valor_PM"
                      ].values,
                      pesos_item,
                  )
                  if len(
                      df_ml.loc[
                          max(idx[0], i - 4) : i - 1, "Valor_PM"
                      ].values
                  )
                  == 4
                  else np.mean(
                      df_ml.loc[
                          max(idx[0], i - 4) : i - 1, "Valor_PM"
                      ].values
                  )
              )
              df_ml.loc[i, "Valor_PM"] = max(0, npm)
              df_semanal.loc[i, "FCST_Promedio_Movil_4S_Opt"] = max(0, npm)
              m_f, s_f, w_f, t_f = (
                  df_ml.loc[i, "Fecha"].month,
                  1 if df_ml.loc[i, "Fecha"].month <= 6 else 2,
                  int(df_ml.loc[i, "Fecha"].strftime("%U")),
                  df_ml.loc[i, "Tendencia"],
              )
              d_rf = [
                  df_ml.loc[i - 1, "Valor_RF"],
                  df_ml.loc[i - 2, "Valor_RF"],
                  df_ml.loc[i - 3, "Valor_RF"],
                  df_ml.loc[i - 4, "Valor_RF"],
                  df_ml.loc[i - 5, "Valor_RF"],
                  df_ml.loc[i - 6, "Valor_RF"],
                  (
                      df_ml.loc[i - 52, "Valor_RF"]
                      if i - 52 in df_ml.index
                      else 0
                  ),
                  m_f,
                  s_f,
                  w_f,
                  t_f,
                  max(0, npm),
              ]
              df_ml.loc[i, "Valor_RF"] = max(
                  0,
                  rf_model.predict(pd.DataFrame([d_rf], columns=features_ml))[
                      0
                  ],
              )
              df_semanal.loc[i, "FCST_RandomForest"] = df_ml.loc[
                  i, "Valor_RF"
              ]
              d_xgb = [
                  df_ml.loc[i - 1, "Valor_XGB"],
                  df_ml.loc[i - 2, "Valor_XGB"],
                  df_ml.loc[i - 3, "Valor_XGB"],
                  df_ml.loc[i - 4, "Valor_XGB"],
                  df_ml.loc[i - 5, "Valor_XGB"],
                  df_ml.loc[i - 6, "Valor_XGB"],
                  (
                      df_ml.loc[i - 52, "Valor_XGB"]
                      if i - 52 in df_ml.index
                      else 0
                  ),
                  m_f,
                  s_f,
                  w_f,
                  t_f,
                  max(0, npm),
              ]
              df_ml.loc[i, "Valor_XGB"] = max(
                  0,
                  xgb_model.predict(pd.DataFrame([d_xgb], columns=features_ml))[
                      0
                  ],
              )
              df_semanal.loc[i, "FCST_XGBoost"] = df_ml.loc[i, "Valor_XGB"]
          except Exception:
            pass

        for col in cols_modelos:
          s_val = df_semanal.loc[idx, col].values.copy()
          for k in range(len(s_val)):
            if not np.isnan(s_val[k]) and s_val[k] < 0:
              v_limp = s_val[max(0, k - 4) : k]
              v_limp = v_limp[~np.isnan(v_limp)]
              s_val[k] = np.mean(v_limp) if len(v_limp) > 0 else 0
          df_semanal.loc[idx, col] = s_val
        bar_progreso.progress((idx_loop + 1) / total_skus)

      if not df_comercial.empty:
        if modo_analisis == "Consolidado":
          df_semanal = df_semanal.merge(
              df_comercial[df_comercial["Item"].isin(codigos_filtrados)]
              .groupby("Fecha")["FCST_Comercial"]
              .sum()
              .reset_index()
              .assign(Item="CONSOLIDADO"),
              on=["Item", "Fecha"],
              how="left",
          )
        else:
          df_semanal = df_semanal.merge(
              df_comercial[["Item", "Fecha", "FCST_Comercial"]],
              on=["Item", "Fecha"],
              how="left",
          )
        if "FCST_Comercial" not in cols_modelos:
          cols_modelos.append("FCST_Comercial")

      temp_merge = df_semanal[["Item", "Fecha"]].merge(
          df_procesar[["Item", "Fecha", "Valor"]],
          on=["Item", "Fecha"],
          how="left",
      )
      df_semanal["Valor"] = temp_merge["Valor"]
      df_final = df_semanal.copy()

      skus_graficos_memoria = []

      for codigo_sku in df_final["Item"].unique():
        df_sku = df_final[df_final["Item"] == codigo_sku].copy()
        descripcion_sku = df_sku["Descripción"].iloc[0]
        categoria_sku = (
            df_sku["Categoria"].iloc[0]
            if "Categoria" in df_sku.columns
            else "S/C"
        )

        df_plot = df_sku.sort_values("Fecha").reset_index(drop=True)
        df_plot["Valor"] = df_plot["Valor"].clip(lower=0)
        df_plot["Valor_Limpio"] = df_plot["Valor_Limpio"].clip(lower=0)

        df_real = df_plot.dropna(subset=["Valor"]).copy()

        df_con_consumo = df_real[df_real["Valor"] > 0]
        ultima_fecha_consumo = (
            df_con_consumo["Fecha"].max()
            if not df_con_consumo.empty
            else pd.NaT
        )
        sin_consumo_4_meses = False
        if pd.isna(ultima_fecha_consumo) or (hoy - ultima_fecha_consumo).days > 120:
          sin_consumo_4_meses = True

        alerta_anomalia = None
        promedio_2w = (
            df_real.tail(2)["Valor"].mean()
            if len(df_real) >= 2
            else df_real["Valor"].mean()
        )
        promedio_3w = (
            df_real.tail(3)["Valor"].mean()
            if len(df_real) >= 3
            else df_real["Valor"].mean()
        )
        promedio_4w = (
            df_real.tail(4)["Valor"].mean()
            if len(df_real) >= 4
            else df_real["Valor"].mean()
        )
        promedio_6w = (
            df_real.tail(6)["Valor"].mean()
            if len(df_real) >= 6
            else df_real["Valor"].mean()
        )

        df_ultimas_6 = df_real.tail(6)

        valores_6w = df_ultimas_6["Valor"].sort_values(ascending=False)
        max_1 = valores_6w.iloc[0] if len(valores_6w) > 0 else 0
        max_2 = valores_6w.iloc[1] if len(valores_6w) > 1 else max_1
        consumo_simulado = (
            (max_1 + max_2 + promedio_4w) / 3 if len(df_real) > 0 else 0
        )

        if len(df_ultimas_6) == 6:
          v_ultimas_2 = df_ultimas_6.tail(2)["Valor"].sum()
